# --- Database ---
DATABASE_URL=postgresql+asyncpg://showscore:showscore@localhost:5432/showscore
SYNC_DATABASE_URL=postgresql+psycopg2://showscore:showscore@localhost:5432/showscore

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost

# --- Score rules ---
SCORE_UPDATE_RULE=higher_only
# options: higher_only | always_overwrite | sum

# --- Rate limiting ---
SCORE_SUBMIT_RATE_LIMIT=10/minute

# --- Admin bootstrap ---
FIRST_ADMIN_EMAIL=admin@showscore.dev
FIRST_ADMIN_PASSWORD=ChangeMe123!
